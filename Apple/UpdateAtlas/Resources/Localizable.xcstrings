    "A known update mechanism can be monitored." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinen bir güncelleme mekanizması izlenebilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известный механизм обновлений можно отслеживать."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein bekannter Update-Mechanismus kann überwacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mécanisme de mise à jour connu peut être surveillé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可监控已知的更新机制。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既知のアップデート機構を監視できます。"
          }
        }
      }
    },
    "Command-line tools found at documented standalone paths, separate from package-manager inventory." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket yöneticisi envanterinden ayrı olarak, belgelenmiş bağımsız yollarda bulunan komut satırı araçları."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты командной строки, найденные по документированным путям отдельных установок, вне перечня пакетных менеджеров."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehlszeilentools unter dokumentierten eigenständigen Pfaden, getrennt vom Bestand der Paketverwaltungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outils en ligne de commande trouvés à des emplacements d’installation indépendants documentés, hors de l’inventaire des gestionnaires de paquets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在文档列出的独立安装路径中找到的命令行工具，不属于包管理器清单。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージマネージャのインベントリとは別に、ドキュメントに記載されたスタンドアロンパスで検出されたコマンドラインツールです。"
          }
        }
      }
    },
    "Installation remnants" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme kalıntıları"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остатки установки"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationsreste"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résidus d’installation"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装残留"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールの残骸"
          }
        }
      }
    },
    "These launchers point to missing files and are not counted as installed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu başlatıcılar eksik dosyalara işaret ediyor ve yüklü olarak sayılmıyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти лаунчеры указывают на отсутствующие файлы и не считаются установленными."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Starter verweisen auf fehlende Dateien und zählen nicht als installiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lanceurs pointent vers des fichiers manquants et ne sont pas comptés comme installés."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些启动器指向缺失的文件，不计为已安装。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのランチャーは存在しないファイルを指しているため、インストール済みとしてカウントされません。"
          }
        }
      }
    },
    "Executable at documented location" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belgelenen konumda çalıştırılabilir dosya"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исполняемый файл в задокументированном расположении"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausführbare Datei am dokumentierten Speicherort"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutable à l’emplacement documenté"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于文档记录位置的可执行文件"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメント記載の場所にある実行ファイル"
          }
        }
      }
    },
    "Publisher installation guide" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayıncı kurulum kılavuzu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Руководство по установке от издателя"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationsanleitung des Herstellers"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guide d’installation de l’éditeur"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发者安装指南"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発元のインストールガイド"
          }
        }
      }
    },
    "The executable is present at a documented default path. Its installer origin and installed version are not proven by that path alone; no executable is run during discovery." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştırılabilir dosya belgelenmiş varsayılan bir yolda mevcut. Kurulum kaynağı ve kurulu sürüm yalnızca bu yolla kanıtlanamaz; keşif sırasında hiçbir çalıştırılabilir dosya çalıştırılmaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исполняемый файл находится по документированному пути по умолчанию. Источник установки и версия не подтверждаются одним лишь путём; при обнаружении исполняемые файлы не запускаются."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausführbare Datei befindet sich unter einem dokumentierten Standardpfad. Installationsherkunft und installierte Version werden durch diesen Pfad allein nicht belegt; bei der Erkennung wird keine Datei ausgeführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exécutable est présent à un chemin par défaut documenté. Son origine d’installation et sa version installée ne sont pas prouvées par ce seul chemin ; aucun exécutable n’est lancé lors de la détection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可执行文件位于文档记录的默认路径中。仅凭该路径无法证明其安装来源和已安装版本；发现过程中不会运行任何可执行文件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメントに記載されたデフォルトのパスに実行ファイルが存在します。このパスだけではインストール元やインストール済みバージョンは証明されず、検出中に実行ファイルが起動されることもありません。"
          }
        }
      }
    },
    "The publisher documents this standalone CLI path. Its update method may vary; Update Atlas does not run it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayıncı bu bağımsız CLI yolunu belgelendiriyor. Güncelleme yöntemi değişebilir; Update Atlas bunu çalıştırmaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Издатель указывает этот путь к автономному CLI в документации. Способ обновления может отличаться; Update Atlas его не запускает."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hersteller dokumentiert diesen eigenständigen CLI-Pfad. Die Update-Methode kann variieren; Update Atlas führt sie nicht aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éditeur documente ce chemin CLI autonome. Sa méthode de mise à jour peut varier ; Update Atlas ne l’exécute pas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发者在文档中说明了此独立 CLI 路径。其更新方式可能有所不同，Update Atlas 不会运行它。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発元はこのスタンドアロン CLI パスを文書化しています。アップデート方法は異なる場合があり、Update Atlas はこれを実行しません。"
          }
        }
      }
    },
    "Based on bundle metadata, signing identity, path, and catalog evidence." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket üst verilerine, imzalama kimliğine, dosya yoluna ve katalog verilerine dayanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На основе метаданных пакета, подписи кода, пути и данных каталога."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basierend auf Bundle-Metadaten, Signaturidentität, Pfad und Katalogbelegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basé sur les métadonnées du paquet, l’identité de signature, le chemin d’accès et les données du catalogue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据应用包元数据、签名身份、路径和目录证据判断。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドルのメタデータ、署名ID、パス、およびカタログの根拠に基づきます。"
          }
        }
      }
    },
    "Details and detection evidence will appear here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıntılar ve algılama kanıtları burada görünecek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся подробности и данные обнаружения."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details und Erkennungsnachweise werden hier angezeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les détails et les preuves de détection s’afficheront ici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详细信息和检测依据将显示在此处。"
          }
        },
        "ja" : {
