      }
    },
    "No supported update source was found. No freshness claim is made." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteklenen bir güncelleme kaynağı bulunamadı. Güncellik iddiasında bulunulmuyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживаемый источник обновлений не найден. Актуальность версии не гарантируется."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde keine unterstützte Update-Quelle gefunden. Über die Aktualität kann keine Aussage getroffen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune source de mise à jour prise en charge n’a été trouvée. Impossible de garantir que le logiciel est à jour."
