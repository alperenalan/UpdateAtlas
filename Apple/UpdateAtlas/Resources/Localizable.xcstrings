    "Scan this Mac to see installed software and where its updates come from." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü yazılımları ve güncellemelerinin nereden geldiğini görmek için bu Mac’i tarayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте этот Mac, чтобы увидеть установленное ПО и источники его обновлений."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne diesen Mac, um installierte Software und die Herkunft ihrer Updates zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysez ce Mac pour voir les logiciels installés et la provenance de leurs mises à jour."
