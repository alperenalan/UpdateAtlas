    "Tracks Steam, Epic, GOG, Battle.net, CrossOver/Whisky Windows bottles, and UTM/VMware/Parallels virtual machines under their parent managers." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam, Epic, GOG ve Battle.net oyunlarını; CrossOver ve Whisky Windows ortamlarını; UTM, VMware ve Parallels sanal makinelerini ilgili yöneticilerinin altında izler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживает библиотеки Steam, Epic, GOG, Battle.net, среды совместимости Windows в CrossOver/Whisky и виртуальные машины UTM/VMware/Parallels в рамках их родительских менеджеров."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasst Steam, Epic, GOG, Battle.net, Windows-Kompatibilitätsumgebungen von CrossOver/Whisky sowie virtuelle Maschinen von UTM/VMware/Parallels unter ihren übergeordneten Managern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit les bibliothèques Steam, Epic, GOG, Battle.net, les environnements de compatibilité Windows CrossOver/Whisky et les machines virtuelles UTM/VMware/Parallels sous leurs gestionnaires parents."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在各自的上级管理器下跟踪 Steam、Epic、GOG、Battle.net、CrossOver/Whisky 的 Windows 兼容环境，以及 UTM/VMware/Parallels 虚拟机。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam、Epic、GOG、Battle.net、CrossOver/Whisky の Windows 互換環境、および UTM/VMware/Parallels の仮想マシンをそれぞれの親マネージャー配下で追跡します。"
          }
        }
      }
    },
