          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam управляет играми, установленными в папках его библиотеки."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam verwaltet Spiele, die in seinen Bibliotheksordnern installiert sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam gère les jeux installés dans les dossiers de sa bibliothèque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 负责管理安装在其库文件夹中的游戏。"
          }
        },
        "ja" : {
          "stringUnit" : {
