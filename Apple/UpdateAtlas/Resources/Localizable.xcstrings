    },
    "Google lists a patch within the installed Android Studio release family, but the bundle does not expose a comparable patch number." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google, kurulu Android Studio sürüm ailesi içinde bir yama listeliyor ancak uygulama paketi karşılaştırılabilir bir yama numarası sunmuyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google указывает на наличие патча в рамках установленного семейства выпусков Android Studio, но пакет приложения не предоставляет сопоставимого номера патча."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google führt einen Patch innerhalb der installierten Android Studio-Versionsfamilie auf, das App-Bundle gibt jedoch keine vergleichbare Patch-Nummer preis."
