    },
    "Updates ready for software with direct or automated update support." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrudan veya otomatik güncelleme desteğine sahip yazılımlar için güncellemeler hazır."
