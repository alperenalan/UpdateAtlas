    "The installation changed or could not be read. Scan again before updating." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum değişti veya okunamadı. Güncellemeden önce yeniden tarayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленная копия изменилась или не читается. Повторите сканирование перед обновлением."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation hat sich geändert oder konnte nicht gelesen werden. Scanne vor dem Aktualisieren erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installation a changé ou n’a pas pu être lue. Relancez une analyse avant la mise à jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装内容已更改或无法读取。请在更新前重新扫描。"
