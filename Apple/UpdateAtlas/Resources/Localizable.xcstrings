            "value" : "Update Atlas はカタログソース解決のため、この ID をキューに追加しました。"
          }
        }
      }
    },
    "Update availability and installation are owned by the parent manager." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme durumu denetimi ve yükleme işlemi üst yöneticiye aittir."
          }
