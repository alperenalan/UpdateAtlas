    "Installation & Update History" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum ve Güncelleme Geçmişi"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История установки и обновлений"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installations- und Updateverlauf"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique des installations et mises à jour"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装与更新历史"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールと更新の履歴"
          }
        }
      }
    },
    "Dates show when Update Atlas observed a new item or installed version. Earlier installations cannot be reconstructed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarihler, Update Atlas’ın yeni bir öğeyi veya kurulu sürümü ne zaman gördüğünü gösterir. Önceki kurulumların zamanı belirlenemez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даты показывают, когда Update Atlas обнаружил новый объект или установленную версию. Время более ранних установок определить нельзя."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeitangaben zeigen, wann Update Atlas ein neues Element oder eine installierte Version erkannt hat. Frühere Installationszeitpunkte lassen sich nicht rekonstruieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates indiquent quand Update Atlas a détecté un nouvel élément ou une version installée. La date des installations antérieures ne peut pas être retrouvée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期表示 Update Atlas 何时发现新项目或已安装版本。无法还原更早的安装时间。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付は Update Atlas が新しい項目やインストール済みバージョンを検出した日時を示します。それ以前のインストール日時は復元できません。"
          }
        }
      }
    },
    "History could not be read or saved." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş okunamadı veya kaydedilemedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать или сохранить историю."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf konnte nicht gelesen oder gespeichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire ou d’enregistrer l’historique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取或保存历史记录。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴の読み込みまたは保存ができませんでした。"
          }
        }
      }
    },
    "No History Yet" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz Geçmiş Yok"
          }
        },
