          }
        }
      }
    },
    "Add folders containing installed apps or game libraries, including external disks. Scans stay within six folder levels and skip nested app contents and symbolic links." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici diskler dahil olmak üzere yüklü uygulamaları veya oyun kütüphanelerini içeren klasörleri ekleyin. Taramalar altı klasör düzeyiyle sınırlı kalır; iç içe uygulama içeriklerini ve sembolik bağlantıları atlar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте папки с установленными приложениями или библиотеками игр, включая внешние диски. Сканирование ограничено шестью уровнями вложенности и пропускает содержимое пакетов приложений и символические ссылки."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Ordner mit installierten Apps oder Spielebibliotheken hinzu, einschließlich externer Laufwerke. Scans prüfen maximal sechs Ordnerebenen und überspringen verschachtelte App-Inhalte sowie symbolische Links."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des dossiers contenant des applications installées ou des bibliothèques de jeux, y compris sur des disques externes. Les analyses se limitent à six niveaux de dossiers et ignorent le contenu interne des paquets ainsi que les liens symboliques."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加包含已安装应用或游戏库的文件夹（包括外置磁盘）。扫描深度不超过六层文件夹，并会跳过嵌套的应用包内容和符号链接。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部ディスクを含む、インストール済みアプリやゲームライブラリが入ったフォルダを追加します。スキャンは6階層までに制限され、ネストされたアプリ内部のコンテンツやシンボリックリンクはスキップされます。"
          }
        }
      }
    },
    "Disconnected or unreadable folders appear in scan diagnostics. Removing a folder does not delete its contents." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantısı kesilmiş veya okunamayan klasörler tarama tanılamasında görünür. Bir klasörü kaldırmak içeriğini silmez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступные или нечитаемые папки отображаются в диагностике сканирования. Удаление папки из списка не удаляет её содержимое."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verbundene oder nicht lesbare Ordner erscheinen in der Scan-Diagnose. Das Entfernen eines Ordners löscht nicht dessen Inhalt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers déconnectés ou illisibles apparaissent dans le diagnostic d’analyse. Retirer un dossier ne supprime pas son contenu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接或无法读取的文件夹会显示在扫描诊断中。移除文件夹不会删除其中的内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切断されているか読み込めないフォルダはスキャン診断に表示されます。フォルダをリストから削除しても、その内容は削除されません。"
          }
        }
      }
    },
    "Local Managers" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Yöneticiler"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальные менеджеры"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Manager"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestionnaires locaux"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地管理器"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルマネージャー"
          }
        }
      }
    },
    "GOG Galaxy, Epic Games, Heroic, Setapp, JetBrains Toolbox, Adobe, CrossOver and Whisky are discovered from local installation records and reviewed folders. Removed games and download-only libraries are excluded." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOG Galaxy, Epic Games, Heroic, Setapp, JetBrains Toolbox, Adobe, CrossOver ve Whisky; yerel kurulum kayıtlarından ve incelenen klasörlerden tespit edilir. Kaldırılmış oyunlar ve yalnızca indirme amaçlı kütüphaneler hariç tutulur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOG Galaxy, Epic Games, Heroic, Setapp, JetBrains Toolbox, Adobe, CrossOver и Whisky обнаруживаются по локальным записям об установке и проверенным папкам. Удалённые игры и библиотеки только для загрузки исключаются."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOG Galaxy, Epic Games, Heroic, Setapp, JetBrains Toolbox, Adobe, CrossOver und Whisky werden anhand lokaler Installationsdaten und geprüfter Ordner erkannt. Entfernte Spiele und reine Download-Bibliotheken werden ausgeschlossen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOG Galaxy, Epic Games, Heroic, Setapp, JetBrains Toolbox, Adobe, CrossOver et Whisky sont détectés à partir des registres d’installation locaux et de dossiers vérifiés. Les jeux supprimés et les bibliothèques ne contenant que des téléchargements sont exclus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOG Galaxy、Epic Games、Heroic、Setapp、JetBrains Toolbox、Adobe、CrossOver 和 Whisky 均通过本地安装记录和受检文件夹发现。已移除的游戏和仅限下载的资源库将被排除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOG Galaxy、Epic Games、Heroic、Setapp、JetBrains Toolbox、Adobe、CrossOver、Whisky は、ローカルのインストール記録と対象フォルダから検出されます。削除済みのゲームやダウンロード専用のライブラリは除外されます。"
          }
        }
      }
    },
    "Discover Docker containers and images" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker kapsayıcılarını ve imajlarını keşfet"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаруживать контейнеры и образы Docker"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker-Container und -Images erkennen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrir les conteneurs et images Docker"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现 Docker 容器和镜像"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker コンテナとイメージを検出"
          }
        }
      }
    },
    "Off by default. Reads only the current Docker connection: image IDs and platforms, container names and state, Compose project/service names and volume names. It does not start Docker, pull images, enter containers or read environment variables, mount paths or registry credentials." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak kapalıdır. Yalnızca mevcut Docker bağlantısını okur: imaj kimlikleri ve platformlar, kapsayıcı adları ve durumları, Compose proje/servis adları ve birim adları. Docker’ı başlatmaz, imaj çekmez, kapsayıcılara girmez veya ortam değişkenlerini, bağlama yollarını ya da kayıt defteri kimlik bilgilerini okumaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. Считывает только текущее подключение Docker: ID и платформы образов, имена и состояния контейнеров, имена проектов и сервисов Compose, а также имена томов. Не запускает Docker, не скачивает образы, не входит в контейнеры и не читает переменные окружения, пути монтирования или учётные данные реестров."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig deaktiviert. Liest nur die aktuelle Docker-Verbindung: Image-IDs und -Plattformen, Container-Namen und -Status, Compose-Projekt-/Dienstnamen sowie Volume-Namen. Startet Docker nicht, lädt keine Images herunter, betritt keine Container und liest weder Umgebungsvariablen noch Mount-Pfade oder Registry-Zugangsdaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut. Lit uniquement la connexion Docker actuelle : identifiants et plateformes des images, noms et états des conteneurs, noms des projets/services Compose et noms des volumes. Ne démarre pas Docker, ne télécharge pas d’images, n’entre pas dans les conteneurs et ne lit pas les variables d’environnement, les chemins de montage ni les identifiants de registre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。仅读取当前 Docker 连接：镜像 ID 与平台、容器名称与状态、Compose 项目/服务名称以及卷名称。不会启动 Docker、拉取镜像、进入容器，也不会读取环境变量、挂载路径或镜像仓库凭据。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトはオフです。現在の Docker 接続（イメージ ID とプラットフォーム、コンテナ名と状態、Compose のプロジェクト名／サービス名、ボリューム名）のみを読み取ります。Docker の起動、イメージのプル、コンテナへの接続、環境変数・マウントパス・レジストリ認証情報の読み取りは行いません。"
          }
        }
      }
    },
    "Image tags are not versions. Docker updates remain managed externally; Update Atlas does not compare private registries or install container updates." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmaj etiketleri sürüm numarası değildir. Docker güncellemeleri harici olarak yönetilmeye devam eder; Update Atlas özel kayıt defterlerini karşılaştırmaz veya kapsayıcı güncellemelerini yüklemez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теги образов не являются версиями. Обновления Docker по-прежнему управляются извне; Update Atlas не сверяет частные реестры и не устанавливает обновления контейнеров."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image-Tags sind keine Versionen. Docker-Updates werden weiterhin extern verwaltet; Update Atlas vergleicht keine privaten Registries und installiert keine Container-Updates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tags d’image ne sont pas des versions. Les mises à jour Docker restent gérées en externe ; Update Atlas ne compare pas les registres privés et n’installe pas les mises à jour de conteneurs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镜像标签不是版本号。Docker 更新仍由外部管理；Update Atlas 不会比对私有镜像仓库，也不会安装容器更新。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージタグはバージョンではありません。Docker のアップデートは引き続き外部で管理されます。Update Atlas はプライベートレジストリの比較やコンテナアップデートのインストールを行いません。"
          }
        }
      }
    },
    "Changes apply to the next scan and are shared with the CLI." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişiklikler bir sonraki taramada uygulanır ve CLI ile paylaşılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения вступят в силу при следующем сканировании и будут общими с CLI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen gelten für den nächsten Scan und werden mit der CLI geteilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications s’appliquent à la prochaine analyse et sont partagées avec la CLI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改将在下次扫描时生效，并与 CLI 共享。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は次回のスキャンから適用され、CLI と共有されます。"
          }
        }
      }
    },
    "Local Docker inventory" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Docker envanteri"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальный инвентарь Docker"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokales Docker-Inventar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inventaire Docker local"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地 Docker 清单"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル Docker インベントリ"
          }
        }
      }
    },
    "This is a local Docker object. Image identity and container state do not establish whether an update exists; Docker owns changes to these objects." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yerel bir Docker nesnesidir. İmaj kimliği ve kapsayıcı durumu bir güncelleme olup olmadığını belirlemez; bu nesnelerdeki değişiklikleri Docker yönetir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это локальный объект Docker. Идентификатор образа и состояние контейнера не определяют наличие обновлений; изменениями этих объектов управляет Docker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein lokales Docker-Objekt. Image-Identität und Container-Status geben keinen Aufschluss darüber, ob ein Update vorliegt; Änderungen an diesen Objekten werden von Docker verwaltet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit d’un objet Docker local. L’identité de l’image et l’état du conteneur ne permettent pas d’établir si une mise à jour existe ; Docker gère les modifications de ces objets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是本地 Docker 对象。镜像标识和容器状态无法确定是否存在更新；这些对象的更改由 Docker 管理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはローカルの Docker オブジェクトです。イメージの識別情報やコンテナの状態からはアップデートの有無を判断できません。これらのオブジェクトの変更は Docker が管理します。"
          }
        }
      }
    },
    "Local Docker connections, Compose projects, containers, images and volumes. These are separate objects, not application counts." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Docker bağlantıları, Compose projeleri, kapsayıcılar, imajlar ve birimler. Bunlar uygulama sayısı değil, ayrı nesnelerdir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальные подключения Docker, проекты Compose, контейнеры, образы и тома. Это отдельные объекты, а не количество приложений."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Docker-Verbindungen, Compose-Projekte, Container, Images und Volumes. Dies sind eigenständige Objekte; sie werden nicht als Apps gezählt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexions Docker locales, projets Compose, conteneurs, images et volumes. Ce sont des objets distincts, pas un nombre d’applications."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地 Docker 连接、Compose 项目、容器、镜像和卷。这些是独立对象，不计入应用数量。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの Docker 接続、Compose プロジェクト、コンテナ、イメージ、ボリューム。これらは個別のオブジェクトであり、アプリ数ではありません。"
          }
        }
      }
    },
