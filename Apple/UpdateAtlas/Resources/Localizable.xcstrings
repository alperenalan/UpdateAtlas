    "No checked software currently has a newer version available." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetlenen yazılımların hiçbirinde şu anda daha yeni bir sürüm yok."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни для одной из проверенных программ сейчас нет более новой версии."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für keine geprüfte Software ist derzeit eine neuere Version verfügbar."
