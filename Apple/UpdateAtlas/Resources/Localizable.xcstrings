        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка наличия и установка обновлений выполняются родительским менеджером."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update-Prüfung und Installation werden vom übergeordneten Manager verwaltet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche et l’installation des mises à jour sont gérées par le gestionnaire parent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
