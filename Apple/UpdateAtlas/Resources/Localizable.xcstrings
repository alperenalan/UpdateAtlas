    "~/.local/bin is present in your environment PATH." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin ortamınızın PATH değişkeninde bulunuyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог ~/.local/bin присутствует в переменной окружения PATH."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin ist in deiner Umgebungsvariable PATH enthalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin est présent dans la variable PATH de votre environnement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环境变量 PATH 中已包含 ~/.local/bin。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境の PATH に ~/.local/bin が含まれています。"
          }
        }
      }
    },
    "~/.local/bin/update-atlas already points to another tool. Update Atlas will not replace it unless you choose Repair Link." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas zaten başka bir araca işaret ediyor. Bağlantıyı Onar’ı seçmedikçe Update Atlas bu bağlantıyı değiştirmez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas уже указывает на другой инструмент. Update Atlas не заменит его, пока вы не выберете «Исправить ссылку»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas verweist bereits auf ein anderes Tool. Update Atlas ersetzt den Link nur, wenn du „Link reparieren“ wählst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas pointe déjà vers un autre outil. Update Atlas ne le remplacera pas, sauf si vous choisissez Réparer le lien."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas 已指向其他工具。除非选择“修复链接”，否则 Update Atlas 不会替换它。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas はすでに別のツールを指しています。「リンクを修復」を選択しない限り、Update Atlas は置き換えません。"
          }
        }
      }
    },
    "Show app icons beside updates in the menu" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüde güncellemelerin yanında uygulama simgelerini göster"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать значки приложений рядом с обновлениями в меню"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Symbole neben Updates im Menü anzeigen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les icônes des apps à côté des mises à jour dans le menu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单中的更新项旁显示应用图标"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューのアップデート項目にアプリアイコンを表示"
          }
        }
      }
    },
    "Shows each application's icon beside its update in the menu. The menu bar keeps the Update Atlas icon and update count." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüde her güncellemenin yanında ilgili uygulamanın simgesi görünür. Menü çubuğunda Update Atlas simgesi ve güncelleme sayısı kalır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок приложения отображается рядом с его обновлением в меню. В строке меню остаются значок Update Atlas и число обновлений."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Menü erscheint neben jedem Update das App-Symbol. In der Menüleiste bleiben das Update-Atlas-Symbol und die Anzahl der Updates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icône de chaque app s’affiche à côté de sa mise à jour dans le menu. La barre des menus conserve l’icône Update Atlas et le nombre de mises à jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单中每个更新项旁会显示相应应用的图标。菜单栏仍显示 Update Atlas 图标和更新数量。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューの各アップデート項目にアプリアイコンを表示します。メニューバーには Update Atlas のアイコンとアップデート件数が残ります。"
          }
        }
      }
    },
    "The installed version could not be read, so it cannot be compared with the latest release." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü sürüm okunamadığı için son sürümle karşılaştırılamıyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать установленную версию, поэтому её нельзя сравнить с последним выпуском."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die installierte Version konnte nicht gelesen werden und lässt sich daher nicht mit dem neuesten Release vergleichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version installée n’a pas pu être lue ; elle ne peut donc pas être comparée à la dernière version."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已安装的版本，因此无法与最新版本进行比较。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのバージョンを読み取れなかったため、最新リリースと比較できません。"
          }
        }
      }
    },
