        }
      }
    },
    "Steam owns this game's update availability and installation. Update Atlas does not offer a separate update action." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oyunun güncelleme durumu ve kurulumu Steam tarafından yönetilir. Update Atlas ayrı bir güncelleme işlemi sunmaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam отвечает за проверку наличия и установку обновлений этой игры. Update Atlas не предлагает отдельного действия для обновления."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ist für die Update-Verfügbarkeit und Installation dieses Spiels zuständig. Update Atlas bietet keine eigene Update-Aktion an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam gère la disponibilité et l’installation des mises à jour de ce jeu. Update Atlas ne propose pas d’action de mise à jour distincte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此游戏的更新检查与安装由 Steam 管理。Update Atlas 不提供单独的更新操作。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームのアップデート確認とインストールは Steam が管理しています。Update Atlas から個別にアップデートすることはできません。"
          }
        }
      }
    },
