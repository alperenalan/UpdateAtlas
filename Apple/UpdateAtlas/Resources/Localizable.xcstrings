          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наличие обновлений можно проверить через провайдер App Store. Установка по-прежнему выполняется через App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
