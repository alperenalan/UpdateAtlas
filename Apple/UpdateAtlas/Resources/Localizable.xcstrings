    "Verified means the latest version was confirmed. Unverified includes checks that are pending, failed, or handled by another app." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Doğrulandı”, en son sürümün onaylandığı anlamına gelir. “Doğrulanmadı” ise bekleyen, başarısız olan veya başka bir uygulamanın yürüttüğü denetimleri kapsar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Подтверждено» означает, что последняя версия подтверждена. «Не подтверждено» включает ожидающие и неудавшиеся проверки, а также проверки, которые выполняет другое приложение."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bestätigt“ bedeutet, dass die neueste Version bestätigt wurde. „Unbestätigt“ umfasst ausstehende und fehlgeschlagene Prüfungen sowie solche, die eine andere App übernimmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Vérifié » indique que la dernière version a été confirmée. « Non vérifié » inclut les vérifications en attente, en échec ou prises en charge par une autre app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“已验证”表示已确认最新版本。“未验证”包含等待中、失败以及由其他 App 负责的检查。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「確認済み」は最新バージョンが確認されたことを示します。「未確認」には、保留中、失敗、またはほかのアプリが担当する確認が含まれます。"
          }
        }
      }
    },
    "Software that has not been checked for updates yet." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz güncelleme denetimi yapılmamış yazılımlar."
          }
        },
