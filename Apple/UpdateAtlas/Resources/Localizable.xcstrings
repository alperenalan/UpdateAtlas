    "Update Atlas is free. Supporting development is optional and never changes scanning or update results." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas ücretsizdir. Geliştirmeyi desteklemek isteğe bağlıdır ve tarama veya güncelleme sonuçlarını asla değiştirmez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas бесплатен. Поддержка разработки необязательна и никогда не влияет на результаты сканирования или проверки обновлений."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas ist kostenlos. Die Unterstützung der Entwicklung ist freiwillig und hat keinerlei Einfluss auf Scan- oder Update-Ergebnisse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas est gratuit. Soutenir le développement est facultatif et ne modifie jamais les résultats d’analyse ou de mise à jour."
          }
