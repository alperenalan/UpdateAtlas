    "The first complete scan creates a baseline. Later scans record newly detected software and installed version changes." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk tam tarama başlangıç durumunu oluşturur. Sonraki taramalar yeni bulunan yazılımları ve kurulu sürüm değişikliklerini kaydeder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое полное сканирование создаёт исходное состояние. Последующие сканирования записывают новое ПО и изменения установленных версий."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste vollständige Scan erstellt einen Ausgangsstand. Spätere Scans erfassen neu erkannte Software und Änderungen installierter Versionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première analyse complète établit un état initial. Les analyses suivantes enregistrent les nouveaux logiciels détectés et les changements de version installée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次完整扫描会建立基线。后续扫描会记录新发现的软件和已安装版本的变化。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の完全なスキャンで基準状態を作成します。以降のスキャンでは、新しく検出されたソフトウェアとインストール済みバージョンの変更を記録します。"
          }
        }
      }
    },
