        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовы обновления для ПО с поддержкой прямого или автоматического обновления."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates bereit für Software mit direkter oder automatischer Update-Unterstützung."
          }
        },
        "fr" : {
          "stringUnit" : {
