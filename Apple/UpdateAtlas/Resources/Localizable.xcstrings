    "Disable a rule to use embedded metadata instead. Some software may then need a catalog rule or a verified version source." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun yerine gömülü üst verileri kullanmak için bir kuralı devre dışı bırakın. Bazı yazılımlar bu durumda bir katalog kuralına veya doğrulanmış sürüm kaynağına ihtiyaç duyabilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите правило, чтобы использовать встроенные метаданные. Некоторым программам после этого может потребоваться правило каталога или проверенный источник версий."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere eine Regel, um stattdessen eingebettete Metadaten zu verwenden. Einige Programme benötigen dann möglicherweise eine Katalogregel oder eine verifizierte Versionsquelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez une règle pour utiliser les métadonnées intégrées à la place. Certains logiciels pourront alors nécessiter une règle de catalogue ou une source de version vérifiée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用规则以改用内嵌元数据。某些软件随后可能需要目录规则或经过验证的版本源。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールを無効にすると、代わりに埋め込みメタデータを使用します。一部のソフトウェアでは、カタログルールや確認済みのバージョンソースが必要になる場合があります。"
          }
        }
      }
    },
