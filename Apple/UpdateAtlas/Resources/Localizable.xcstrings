    "Test notification could not be delivered." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test bildirimi gönderilemedi."
          }
        },
        "ru" : {
          "stringUnit" : {
