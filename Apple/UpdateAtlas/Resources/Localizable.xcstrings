    "Steam's local manifest records a newer target build. Open Steam to download or finish this game's update." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam’in yerel manifestinde daha yeni bir hedef yapı kayıtlı. Bu oyunun güncellemesini indirmek veya tamamlamak için Steam’i açın."
