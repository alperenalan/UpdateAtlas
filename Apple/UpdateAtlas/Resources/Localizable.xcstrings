    "Update Atlas checks installed macOS apps, games, CLI tools, Windows bottles, and virtual machines to show who manages each update." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas, yüklü macOS uygulamalarını, oyunları, CLI araçlarını, Windows uyumluluk ortamlarını ve sanal makineleri tarayarak güncellemelerini kimin yönettiğini gösterir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas проверяет установленные приложения macOS, игры, инструменты CLI, среды совместимости Windows и виртуальные машины, чтобы показать, кто отвечает за каждое обновление."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas prüft installierte macOS-Apps, Spiele, CLI-Tools, Windows-Kompatibilitätsumgebungen und virtuelle Maschinen und zeigt, wer für die jeweiligen Updates zuständig ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas analyse les apps macOS, jeux, outils CLI, environnements de compatibilité Windows et machines virtuelles installés, puis indique qui gère leurs mises à jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas 检查已安装的 macOS 应用、游戏、CLI 工具、Windows 兼容环境和虚拟机，并显示每项更新由谁管理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Atlas は、インストール済みの macOS アプリ、ゲーム、CLI ツール、Windows 互換環境、仮想マシンを調べ、それぞれのアップデートの管理元を表示します。"
          }
        }
      }
    },
    "Updated the ~/.local/bin/update-atlas symlink to point to this application bundle." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas sembolik bağlantısı bu uygulama paketine işaret edecek şekilde güncellendi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символическая ссылка ~/.local/bin/update-atlas обновлена и указывает на этот пакет приложения."
          }
        },
        "de" : {
          "stringUnit" : {
