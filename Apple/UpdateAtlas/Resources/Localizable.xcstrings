          }
        }
      }
    },
    "The installed version changed successfully." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulu sürüm başarıyla değiştirildi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленная версия успешно изменена."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die installierte Version wurde erfolgreich geändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version installée a bien été modifiée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装版本已成功更改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのバージョンが正常に変更されました。"
          }
        }
      }
    },
    "The manager reports no update for this item." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici bu öğe için güncelleme bildirmiyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менеджер сообщает об отсутствии обновлений для этого объекта."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Manager meldet kein Update für dieses Objekt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gestionnaire ne signale aucune mise à jour pour cet élément."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理器报告此项目没有可用更新。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マネージャーによると、この項目のアップデートはありません。"
          }
        }
      }
    },
    "The manager returned, but installation is not yet verified. It may still be pending in the manager. Review its output and scan again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici yanıt verdi ancak kurulum henüz doğrulanmadı. İşlem yöneticide hâlâ bekliyor olabilir. Çıktısını inceleyip yeniden tarayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менеджер завершил работу, но установка ещё не подтверждена. Возможно, она всё ещё ожидает выполнения в менеджере. Проверьте его вывод и повторите сканирование."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Manager wurde beendet, aber die Installation ist noch nicht bestätigt. Möglicherweise steht sie im Manager noch aus. Prüfe dessen Ausgabe und scanne erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gestionnaire a terminé son exécution, mais l’installation n’est pas encore vérifiée. Elle est peut-être toujours en attente dans le gestionnaire. Consultez sa sortie et relancez l’analyse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理器已返回，但安装尚未验证，可能仍在管理器中等待处理。请查看其输出并重新扫描。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マネージャーの処理は終了しましたが、インストールはまだ確認されていません。マネージャー側で保留中の可能性があります。出力を確認してから再スキャンしてください。"
          }
        }
      }
    },
    "Installation may be incomplete or still running in the manager. Review its output and scan again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme tamamlanmamış olabilir veya yöneticide hâlâ devam ediyor olabilir. Çıktıyı inceleyip yeniden tarayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка может быть не завершена или всё ещё выполняется в менеджере. Проверьте вывод и повторите сканирование."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation ist möglicherweise unvollständig oder läuft noch im Manager. Prüfe dessen Ausgabe und scanne erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installation est peut-être incomplète ou toujours en cours dans le gestionnaire. Vérifiez sa sortie et relancez l’analyse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装可能未完成或仍在管理器中运行。请查看其输出并重新扫描。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールが未完了か、マネージャーで実行中の可能性があります。出力を確認してから再スキャンしてください。"
          }
        }
      }
    },
    "The installation changed since the scan. Scan again before updating." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taramadan bu yana kurulum değişti. Güncellemeden önce yeniden tarayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленная копия изменилась после сканирования. Повторите сканирование перед обновлением."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation hat sich seit dem Scan geändert. Scanne vor dem Aktualisieren erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installation a changé depuis l’analyse. Relancez une analyse avant la mise à jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自上次扫描以来，安装内容已更改。请在更新前重新扫描。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャン後にインストール内容が変更されました。アップデート前に再スキャンしてください。"
          }
        }
      }
    },
    "The update manager could not be verified. Open its own update window." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme yöneticisi doğrulanamadı. Kendi güncelleme penceresini açın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить менеджер обновлений. Откройте его собственное окно обновления."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Update-Manager konnte nicht überprüft werden. Öffne dessen eigenes Update-Fenster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gestionnaire de mise à jour n’a pas pu être vérifié. Ouvrez sa propre fenêtre de mise à jour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证更新管理器。请打开其自带的更新窗口。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートマネージャーを検証できませんでした。マネージャー独自のアップデートウインドウを開いてください。"
          }
        }
      }
    },
    "The manager did not complete the update. Review its output and scan again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici güncellemeyi tamamlamadı. Çıktısını inceleyip yeniden tarayın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менеджер не завершил обновление. Проверьте его вывод и повторите сканирование."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Manager hat das Update nicht abgeschlossen. Prüfe dessen Ausgabe und scanne erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gestionnaire n’a pas terminé la mise à jour. Consultez sa sortie et relancez l’analyse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理器未完成更新。请查看其输出并重新扫描。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マネージャーがアップデートを完了しませんでした。出力を確認してから再スキャンしてください。"
          }
        }
      }
    },
    "Homebrew cannot safely update this item here: it may be pinned, have no checksum, or use a prerelease. Use Homebrew directly." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew bu öğeyi buradan güvenli bir şekilde güncelleyemez: sabitlenmiş olabilir, sağlama toplamı olmayabilir veya ön sürüm kullanıyor olabilir. Doğrudan Homebrew kullanın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew не может безопасно обновить этот элемент отсюда: возможно, он закреплён, не имеет контрольной суммы или использует предварительную версию. Используйте Homebrew напрямую."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew kann dieses Objekt hier nicht sicher aktualisieren: Es ist möglicherweise angeheftet, hat keine Prüfsumme oder nutzt eine Vorabversion. Verwende Homebrew direkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ne peut pas mettre à jour cet élément en toute sécurité ici : il est peut-être épinglé, dépourvu de somme de contrôle ou en préversion. Utilisez Homebrew directement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 无法在此安全地更新此项：它可能已固定版本、缺少校验和或使用预发布版本。请直接使用 Homebrew。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めされているか、チェックサムがないか、プレリリースを使用している可能性があるため、Homebrew はここでこの項目を安全にアップデートできません。Homebrew を直接使用してください。"
          }
        }
      }
    },
    "Microsoft AutoUpdate checks availability itself. You will confirm before an update is requested." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft AutoUpdate güncelleme olup olmadığını kendisi denetler. Güncelleme istenmeden önce onaylamanız gerekir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft AutoUpdate самостоятельно проверяет наличие обновлений. Перед запросом обновления потребуется ваше подтверждение."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft AutoUpdate prüft die Verfügbarkeit selbst. Du bestätigst, bevor ein Update angefordert wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft AutoUpdate vérifie lui-même la disponibilité des mises à jour. Une confirmation vous sera demandée avant toute requête."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft AutoUpdate 会自行检查更新。请求更新前需要您的确认。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft AutoUpdate が独自に利用可能なアップデートを確認します。アップデートを要求する前に確認が求められます。"
          }
        }
      }
    },
    "Keep Update Atlas open until the manager finishes." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici işlemi tamamlayana kadar Update Atlas’ı açık tutun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте Update Atlas, пока менеджер не завершит работу."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Update Atlas geöffnet, bis der Manager fertig ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Update Atlas ouvert jusqu’à ce que le gestionnaire ait terminé."
          }
