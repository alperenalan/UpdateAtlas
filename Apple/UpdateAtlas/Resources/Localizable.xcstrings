        }
      }
    },
    "Installed at ~/.local/bin/update-atlas. If your shell cannot find it, add ~/.local/bin to PATH. The link follows this app when it is replaced at the same location." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/update-atlas konumuna yüklendi. Kabuğunuz bulamazsa PATH değişkenine ~/.local/bin ekleyin. Bu uygulama aynı konumda yenilendiğinde bağlantı geçerliliğini korur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установлено в ~/.local/bin/update-atlas. Если оболочка не находит команду, добавьте ~/.local/bin в PATH. Ссылка продолжит работать при замене приложения в том же месте."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert unter ~/.local/bin/update-atlas. Falls deine Shell den Befehl nicht findet, füge ~/.local/bin zu PATH hinzu. Der Link bleibt gültig, wenn diese App am selben Speicherort ersetzt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé dans ~/.local/bin/update-atlas. Si votre shell ne le trouve pas, ajoutez ~/.local/bin à votre PATH. Le lien suit cette app lorsqu’elle est remplacée au même emplacement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装至 ~/.local/bin/update-atlas。如果 Shell 找不到该命令，请将 ~/.local/bin 添加到 PATH。当此应用在同一位置被替换时，链接依然有效。"
          }
        },
        "ja" : {
